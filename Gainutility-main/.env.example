# Optional. Canonical production origin used for sitemap generation and
# SEO fallbacks (defaults to https://gainutility.com when unset).
VITE_SITE_URL=https://gainutility.com

# Optional. Chrome Web Store listing for the GainUtility browser extension.
# The "Add to Chrome" call-to-action only renders when this is set. Leave
# empty until the extension is submitted and approved in the store.
# VITE_CHROME_EXTENSION_STORE_URL=https://chromewebstore.google.com/detail/<id>

